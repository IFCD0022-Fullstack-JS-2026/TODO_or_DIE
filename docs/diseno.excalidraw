    {
      "id": "DSndrKTPOvq8hRi8mNhMz",
      "type": "text",
      "x": -1385.973602226308,
      "y": 289.2629285568358,
      "width": 621.48779296875,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aU",
